# Copy to .env/.env.development.local and adjust for your machine.
REVO_DEV_GRAPHQL_PORT=19222
REVO_ADMIN_PORT=5173
# Optional public URL embedded into the SPA at build time (defaults to /graphql):
# REACT_APP_GRAPHQL_SERVER_URL=/graphql
# For a backend on another host, set its origin instead of the local port:
# REVO_ADMIN_GRAPHQL_TARGET=http://backend.example:19222
